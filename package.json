{
  "name": "agentwatch",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:ai": "services\\ai\\.venv\\Scripts\\python -m uvicorn agentwatch_ai.main:app --reload --port 8000",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "turbo format"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "packageManager": "npm@11.6.2"
}
